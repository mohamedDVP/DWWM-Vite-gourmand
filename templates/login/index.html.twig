{% extends 'layouts/public.html.twig' %}
{% block title %}Authentification{% endblock %}
{% block content %}
    <div class="auth-container">
        <nav class="auth-tabs">
            <button class="btn btn-secondary active" type="button" id="tab-login">Se connecter</button>
            <button class="btn btn-secondary" type="button" id="tab-register">Créer un compte</button>
        </nav>
        <section id="connexion">
            <h1>Connexion</h1>
            <form>
                <div class="form-group">
                    <label for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" autocomplete="email" required>
                </div>
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required>
                    <a href="{{ path('app_forgot_password') }}" class="forgot-password-link">Mot de passe oublié ?</a>
                </div>
                <button class="btn btn-primary" type="submit">Se connecter</button>
            </form>
        </section>

        <section id="inscription">
            <h1>Inscription</h1>
            <form>
                <div class="form-group">
                    <label for="name">Nom</label>
                    <input type="text" id="name" name="name" autocomplete="name" required>
                </div>
                <div class="form-group">
                    <label for="register_email">Adresse e-mail</label>
                    <input type="email" id="register_email" name="register_email" autocomplete="email" required>
                </div>
                <div class="form-group">
                    <label for="register-password">Mot de passe</label>
                    <input type="password" id="register-password" name="register_password" autocomplete="new-password" required>
                </div>
                <div class="form-group">
                    <label for="password-confirm">Confirmer le mot de passe</label>
                    <input type="password" id="password-confirm" name="password_confirm" autocomplete="new-password" required>
                </div>
                <button class="btn btn-primary" type="submit">S'inscrire</button>
            </form>
        </section>
    </div>
{% endblock %}