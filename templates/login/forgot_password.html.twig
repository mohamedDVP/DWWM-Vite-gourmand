{% extends 'layouts/public.html.twig' %}

{% block title %}Réinitialiser mon mot de passe{% endblock %}

{% block content %}
    <div class="forgot-password-container">
        <h1>Réinitialiser mon mot de passe</h1>
        <p>Entrez votre adresse e-mail ci-dessous et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>
        <form>
            <div class="form-group">
                <label for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
            <button class="btn btn-primary" type="submit">Envoyer le lien</button>
        </form>
        <a href="{{ path('app_login') }}" class="back-to-login-link">Retour à la page de connexion</a>
    </div>
{% endblock %}